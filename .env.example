# Name shown in the hero. Never commit a real team name you don't want public.
FANTASY_TEAM_NAME=Demo Team

# 1 (default) = serve built-in mock Flaim/ESPN-shaped data. 0 = try live ESPN.
MOCK_FANTASY=1

# Set to "disconnected" to preview the "Connect Flaim" empty state in mock mode.
# You can also append ?state=disconnected to the page URL.
MOCK_FANTASY_STATE=

# Live mode only (MOCK_FANTASY=0). Works for ESPN leagues set to "viewable to public".
# No ESPN cookies or tokens are used or needed.
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
ESPN_SEASON=
